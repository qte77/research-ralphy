# Compound-learning settings, sourced by .scaffolds/contrib.sh and the weekly workflow.
# Every value can be overridden from the environment; the defaults fit the qte77 Codespace.
# Variables are documented in docs/configuration.md.
WORKSPACE_ROOT="${WORKSPACE_ROOT:-/workspaces/qte77}"
CLAUDE_HOME="${CLAUDE_HOME:-$HOME/.claude}"
COMPOUND_ENABLED="${COMPOUND_ENABLED:-true}"
REPO_INDEX="${REPO_INDEX:-$WORKSPACE_ROOT/qte77/registry/index.json}"
COMPOUND_LEARNINGS_PATH="${COMPOUND_LEARNINGS_PATH:-$WORKSPACE_ROOT/ai-agents-research/docs/learnings}"
COMPOUND_MEMORY_PATH="${COMPOUND_MEMORY_PATH:-$WORKSPACE_ROOT/ai-agents-research/triage}"
COMPOUND_PLANS_PATH="${COMPOUND_PLANS_PATH:-$CLAUDE_HOME/plans}"
CC_PROJECTS_PATH="${CC_PROJECTS_PATH:-$CLAUDE_HOME/projects}"
CC_TASKS_PATH="${CC_TASKS_PATH:-$CLAUDE_HOME/tasks}"
CC_TEAMS_PATH="${CC_TEAMS_PATH:-$CLAUDE_HOME/teams}"
CC_STATS_PATH="${CC_STATS_PATH:-$CLAUDE_HOME/stats-cache.json}"
COMPOUND_WRITEBACK_ENABLED="${COMPOUND_WRITEBACK_ENABLED:-true}"
COMPOUND_WRITEBACK_INTERVAL="${COMPOUND_WRITEBACK_INTERVAL:-3}"
COMPOUND_WRITEBACK_TARGET="${COMPOUND_WRITEBACK_TARGET:-$WORKSPACE_ROOT/ai-agents-research/docs/learnings}"
